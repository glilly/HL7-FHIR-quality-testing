# Generated Synthea/FHIR artifacts
2026/patients/raw/**
2026/patients/enriched/**
!2026/patients/raw/.gitkeep
!2026/patients/enriched/.gitkeep

# Generated validation outputs can be large; keep curated summaries tracked.
2026/scorecards/inferno/raw/**
2026/cohorts/*/reports/raw/**
2026/patients/ingest-responses*/
2026/patients/*response*.json
2026/cohorts/**/load1-response-*.json

.env
*.log
__pycache__/
node_modules/
2026/artifacts/

# VSAC expansions are UMLS-license-sensitive — regenerate locally, do not publish.
2026/measures/**/cqm/value_sets.json
2026/measures/**/cqm/value_sets.stub-pre-vsac-*.json
2026/measures/**/cqm/value_sets.vsac*.json

# Full cqm-execution dumps are large; keep the summary tracked if desired.
2026/cohorts/**/reports/cqm-execution-batch.json

# Regenerable QDM patient conversions (large).
2026/cohorts/**/qdm-patients/**

# RPMS round-trip patient Bundle exports and QDM conversions are
# large/regenerable (refetch via GET /fhir?dfn= per eval-manifest.tsv).
2026/cohorts/rpms/**/bundles/**
2026/cohorts/rpms/**/cql/*.qdm.json

# Empty overnight overwrite artifact (keep local only).
2026/measures/**/cqm/value_sets.empty-*.json

# Local run logs directory (also covered by *.log).
logs/

